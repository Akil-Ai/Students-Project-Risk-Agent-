# Database Configuration
DATABASE_URL=sqlite:///./data/project_agent.db

# Initial Admin Credentials (used only to bootstrap on empty database)
INITIAL_ADMIN_EMAIL=admin@college.edu
INITIAL_ADMIN_PASSWORD=Admin@123456
INITIAL_ADMIN_NAME="System Administrator"

# Application Security
SECRET_KEY=super-secret-key-change-this-in-production-1234567890
ACCESS_TOKEN_EXPIRE_MINUTES=480

# SMTP / Email Configuration (Optional: fallback to console/file logs if empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=alerts@college.edu
SMTP_USE_TLS=true

# App Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
